{
  "name": "@gi-tcg/benchmark",
  "version": "0.1.0",
  "description": "Genius Invokation TCG benchmarks — card knowledge + gold-match evaluation",
  "type": "module",
  "types": "./gi-knowledge/dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./gi-knowledge/dist/index.d.mts",
      "development": ["./gi-knowledge/src/index.ts", "./gi-knowledge/dist/index.mjs"],
      "import": "./gi-knowledge/dist/index.mjs"
    },
    "./internal/*": "./gi-knowledge/src/*.ts"
  },
  "files": [
    "gi-knowledge/dist"
  ],
  "scripts": {
    "build": "cd gi-knowledge && tsdown",
    "check": "tsc --noEmit -p tsconfig.json",
    "generate": "cd gi-knowledge && gnx src/cli/generate.ts",
    "evaluate": "cd gi-knowledge && gnx src/cli/evaluate.ts",
    "score": "cd gi-knowledge && gnx src/cli/score.ts",
    "annotate": "gnx deck-analysis/src/cli/annotate.ts",
    "assemble-record": "gnx battle-benchmark/src/cli/assemble.ts",
    "evolve": "gnx battle-benchmark/src/evolve/run.ts",
    "evolve:compare": "gnx battle-benchmark/src/evolve/compare-arms.ts",
    "analyze": "gnx tree-bench/src/cli/analyze.ts",
    "analyze:demo": "gnx tree-bench/src/cli/analyze.ts --demo"
  },
  "dependencies": {
    "@gi-tcg/assets-manager": "workspace:*",
    "@gi-tcg/data": "workspace:*",
    "@gi-tcg/core": "workspace:*",
    "@gi-tcg/config": "workspace:*",
    "@inquirer/prompts": "^7.3.2"
  },
  "devDependencies": {
    "@gi-tcg/config": "workspace:*",
    "@types/node": "^22.17.0",
    "glob": "^11.0.3"
  }
}
