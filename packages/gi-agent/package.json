    "self-play:topup": "gnx src/learning/self-play/cli/run-self-play-topup.ts",
    "rl:export-dataset": "gnx src/learning/rl/cli/run-export-rl-dataset.ts",
    "rl:smoke": "gnx src/learning/rl/cli/run-self-play-rl-smoke.ts",
    "rl:sample": "gnx src/learning/rl/cli/run-sample-games.ts",
    "combat-window:extract": "gnx src/learning/combat-windows/cli/run-extract-windows.ts",
    "combat-window:analyze": "gnx src/learning/combat-windows/cli/run-post-analysis.ts",
    "combat-window:validate": "gnx src/learning/combat-windows/cli/run-validate-trees.ts",
    "combat-window:align-replay": "gnx src/learning/combat-windows/cli/run-align-replay.ts",
    "combat-window:import-branch-eval": "gnx src/learning/combat-windows/cli/run-import-branch-eval.ts",
    "combat-window:export-library": "gnx src/learning/combat-windows/cli/run-export-library.ts",
    "combat-window:query-library": "gnx src/learning/combat-windows/cli/run-query-library.ts",
    "combat-window:evaluate-library": "gnx src/learning/combat-windows/cli/run-evaluate-library.ts",
    "combat-window:evaluate-workload": "gnx src/learning/combat-windows/cli/run-evaluate-workload.ts",
    "combat-window:export-concepts": "gnx src/learning/combat-windows/cli/run-export-combat-window-concepts.ts",
    "combat-window:export-combo-concepts": "gnx src/learning/combat-windows/cli/run-export-combo-window-concepts.ts",
    "spl:compile": "gnx src/runtime/plan/cli/run-compile-all.ts",
    "fingerprint:generate": "gnx src/learning/fingerprint/cli/generate-fingerprints.ts",
    "encoder:export-dataset": "gnx src/learning/encoder/cli/run-export-encoder-dataset.ts"
