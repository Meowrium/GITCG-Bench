{
  "$schema": "https://opencode.ai/config.json",
  "model": "GLM-5",
  "provider": {
    "myprovider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Baishan",
      "options": {
        "baseURL": "https://api.edgefn.net/v1",
        "apiKey": "***"
      },
      "models": {
        "GLM-5": {
          "name": "GLM-5",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "MiniMax-M2.5": {
          "name": "MiniMax-M2.5",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "genius-invokation-p0": {
      "type": "local",
      "command": [
        "bun",
        "run",
        "packages/mcp/standalone-mcp.ts",
        "--who",
        "0",
        "--tool-exposure-mode",
        "fragmented-decision",
        "--url",
        "http://localhost:3901"
      ],
      "environment": {
        "MCP_TOOL_EXPOSURE_MODE": "fragmented-decision",
        "MCP_HTTP_API_TOKEN": "Ej6Z+5rTz4F2MybnGtYXlgFRhP/t+E5U+VfTvq8lOI8="
      },
      "enabled": true,
      "timeout": 120000
    },
    "genius-invokation-p1": {
      "type": "local",
      "command": [
        "bun",
        "run",
        "packages/mcp/standalone-mcp.ts",
        "--who",
        "1",
        "--tool-exposure-mode",
        "fragmented-decision",
        "--url",
        "http://localhost:3901"
      ],
      "environment": {
        "MCP_TOOL_EXPOSURE_MODE": "fragmented-decision",
        "MCP_HTTP_API_TOKEN": "Ej6Z+5rTz4F2MybnGtYXlgFRhP/t+E5U+VfTvq8lOI8="
      },
      "enabled": true,
      "timeout": 120000
    }
  },
  "plugin": [],
  "skills": {
    "paths": []
  }
}
