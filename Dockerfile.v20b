# Incremental from local v19 cache
FROM localhost/bench-llm:v16-gbrl-v19

COPY eci-files/pipeline-mcts-gbdt.sh /app/pipeline.sh
RUN chmod +x /app/pipeline.sh

COPY packages/gi-ml/src/datasets/rl-value.ts /app/packages/gi-ml/src/datasets/rl-value.ts

WORKDIR /app
ENTRYPOINT ["/bin/bash"]
CMD ["/app/pipeline.sh"]
