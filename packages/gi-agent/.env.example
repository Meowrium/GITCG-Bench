# ─────────────────────────────────────────────────────────────────────────────
# @gi-tcg/agent 环境配置模板
# 用法：复制本文件为 .env，填入真实值后保存。
#       通过 `node --env-file=.env`（或在调用 pnpm 脚本前 `set -a; source .env; set +a`）
#       加载到当前 shell；CLI 启动后即可读到 process.env.OPENAI_API_KEY 等。
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (必填) ────────────────────────────────────────────────────────────────
# OpenAI API Key（或兼容接口的 Key，如 DeepSeek / 月之暗面 / Azure）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：自定义 API 地址（使用国内代理或 Azure 时填写）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：默认使用的模型（也可通过 --model 命令行参数覆盖）
# OPENAI_MODEL=gpt-4o


# ── 游戏服务器 (可选，默认 localhost:3901) ────────────────────────────────────
# standalone 游戏服务器的 HTTP 地址（也可通过 --base-url 参数覆盖）
# GI_SERVER_URL=http://localhost:3901


# ── PostgreSQL 对局数据库 (Phase 2 数据提取，暂时留空) ────────────────────────
# 用于 ReplayExtractor 从服务端拉取历史对局数据，训练 Logistic Regression。
# 若尚未接入，留空即可，Extractor 会以 STUB 模式运行。
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=gitcg
# PG_PASSWORD=your_db_password
# PG_DATABASE=gitcg_prod
