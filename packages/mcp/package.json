{
  "name": "@gi-tcg/mcp",
  "version": "0.17.4",
  "type": "module",
  "description": "MCP (Model Context Protocol) implementation for Genius Invokation TCG",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
