{
  "name": "@gi-tcg/agent",
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-agent system for Genius Invokation TCG: scoring calibration, battle AI, and R&D automation",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": [
        "./src/index.ts",
        "./dist/index.js"
      ],
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src/",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "scoring:audit": "gnx src/agents/scoring-auditor.ts",
    "generate:temporal-profiles": "gnx src/knowledge/temporal-profiles/generate-profiles.ts",
    "battle": "gnx src/agents/battle-agent.ts",
    "benchmark": "gnx src/evaluation/benchmark/cli/run-benchmark.ts",
    "branch-eval": "gnx src/evaluation/branch-eval/cli/run-branch-eval.ts",
    "plan:validate": "gnx src/runtime/plan-oneshot/cli/run-plan-validate.ts",
    "plan:batch": "gnx src/runtime/plan-oneshot/cli/run-plan-batch.ts",
    "plan:author": "gnx src/runtime/plan-oneshot/cli/run-plan-author.ts",
    "plan:reflect": "gnx src/runtime/plan-oneshot/cli/run-plan-reflect.ts",
    "plan:organize-export": "gnx src/runtime/plan-oneshot/cli/run-plan-organize-export.ts",
    "plan:ablate": "gnx src/runtime/plan-oneshot/cli/run-plan-ablate.ts",
